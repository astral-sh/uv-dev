{
  "version": 1,
  "rules": [
    {
      "on": ["pull_request"],
      "caller_workflow": "ci.yml",
      "caller_ref": "refs/pull/*/merge",
      "environment": "automations",
      "reusable_workflow": "astral-sh/uv-dev/.github/workflows/publish-binary-size.yml@373da20ba8956b8b585d29d706ebb2f5d565432b",
      "permissions": { "pull-request": ["read", "write"] }
    },
    {
      "on": ["workflow_dispatch"],
      "caller_workflow": "publish-test-inventory.yml",
      "caller_ref": "refs/heads/main",
      "environment": "automations",
      "reusable_workflow": "astral-sh/uv/.github/workflows/publish-test-inventory.yml@refs/heads/main",
      "permissions": { "workflow": ["read", "write"] }
    },
    {
      "on": ["workflow_dispatch"],
      "caller_workflow": "publish-test-inventory.yml",
      "caller_ref": "refs/heads/main",
      "environment": "automations",
      "reusable_workflow": "astral-sh/uv-dev/.github/workflows/publish-test-inventory.yml@refs/heads/main",
      "permissions": { "workflow": ["read", "write"] }
    }
  ]
}
