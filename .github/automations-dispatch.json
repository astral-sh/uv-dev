{
  "version": 2,
  "repositories": {
    "uv": {
      "name": "astral-sh/uv",
      "id": 699532645
    },
    "uv-dev": {
      "name": "astral-sh/uv-dev",
      "id": 1302176231
    }
  },
  "rules": [
    {
      "repository": "uv-dev",
      "on": {
        "pull_request": ["ready_for_review"]
      },
      "workflow": "promote-pull-request.yml"
    },
    {
      "repository": "uv",
      "on": {
        "pull_request": [
          "opened",
          "synchronize",
          "reopened",
          "ready_for_review"
        ]
      },
      "conditions": {
        "/pull_request/base/ref": "main"
      },
      "workflow": "pull-request-reviewers.yml"
    }
  ]
}
