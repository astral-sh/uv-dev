+/// Read native permission bits through the generated-Python host adapter.
+#[cfg(target_os = "wasi")]
+#[expect(unsafe_code, reason = "WASI host import for filesystem metadata")]
+pub fn host_mode(path: &Path) -> std::io::Result<u32> {
+    #[link(wasm_import_module = "uv_build_slim")]
+    unsafe extern "C" {
+        fn file_mode(path: *const u8, length: usize) -> u32;
+    }
+    let bytes = path.as_os_str().as_encoded_bytes();
+    // SAFETY: The host reads exactly `length` bytes synchronously; the path stays
+    // borrowed and valid for the complete call, and the host does not retain it.
+    let mode = unsafe { file_mode(bytes.as_ptr(), bytes.len()) };
+    if mode & 0x8000_0000 != 0 {
+        Err(std::io::Error::from_raw_os_error(
+            (mode & 0x7fff_ffff) as i32,
+        ))
+    } else {
+        Ok(mode)
+    }
+}
