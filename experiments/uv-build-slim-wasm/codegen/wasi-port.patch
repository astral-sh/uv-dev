+#[cfg(target_os = "wasi")]
+pub fn create_symlink(src: impl AsRef<Path>, dst: impl AsRef<Path>) -> std::io::Result<()> {
+    let destination = dst.as_ref();
+    let parent = std::fs::File::open(destination.parent().unwrap_or(Path::new(".")))?;
+    let name = destination.file_name().ok_or_else(|| {
+        std::io::Error::new(
+            std::io::ErrorKind::InvalidInput,
+            "symlink destination has no filename",
+        )
+    })?;
+    std::os::wasi::fs::symlink(src.as_ref(), &parent, name)
+}
