load("@apple_support//xcode:xcode_config.bzl", "xcode_config")

xcode_config(name = "disable_xcode")

platform(
    name = "local_linux",
    constraint_values = ["@llvm//constraints/libc:gnu.2.28"],
    parents = ["@platforms//host"],
)

platform(
    name = "linux_x86_64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
        "@bazel_tools//tools/cpp:clang",
        "@llvm//constraints/libc:gnu.2.28",
    ],
    exec_properties = {
        "Arch": "amd64",
        "OSFamily": "Linux",
        "container-image": "docker://docker.io/mbolin491/codex-bazel@sha256:0a8e56bfaa3b2e5279db0d3bb2d62b44ba5e5d63a37d97eb8790f49da570af70",
    },
)

alias(
    name = "uv",
    actual = "//crates/uv:uv-bin",
)

test_suite(
    name = "pep440-tests",
    tests = ["//crates/uv-pep440:uv-pep440-unit-tests"],
)

exports_files([
    "Cargo.lock",
    "Cargo.toml",
])
