+// Keep the allocator used by the production uv binary.
+extern crate uv_performance_memory_allocator;
+
+pub mod shared;
+
+use std::hint::black_box;
+use std::time::Instant;
+
+use anyhow::{Context, Result, bail, ensure};
+use serde_json::json;
+use sha2::{Digest, Sha256};
+
+fn main() -> Result<()> {
+    let arguments = std::env::args().skip(1).collect::<Vec<_>>();
+    let [mode, fixture_path, rest @ ..] = arguments.as_slice() else {
+        bail!("expected admit FIXTURE or sample FIXTURE CASE CLOCK ITERATIONS");
+    };
+    let bytes = std::fs::read(fixture_path)?;
+    let fixture_sha256 = Sha256::digest(&bytes).iter().map(|byte| format!("{byte:02x}")).collect::<String>();
+    let cases = shared::cases(&bytes)?;
+    match (mode.as_str(), rest) {
+        ("admit", []) => println!(
+            "{}",
+            json!({"fixture_sha256": fixture_sha256, "payload": shared::admit(&cases)?})
+        ),
+        ("sample", [case_id, clock, iterations]) => {
+            ensure!(clock == shared::CLOCK, "unexpected clock");
+            let iterations = iterations
+                .parse::<u64>()
+                .context("invalid iteration count")?;
+            ensure!(
+                (1..=1_048_576).contains(&iterations),
+                "iteration count exceeds fixed cap"
+            );
+            let case = shared::timed_case(&cases, case_id)?;
+            let before = case.report()?;
+            let groups = before["outcome"]["groups"]
+                .as_array()
+                .context("timed case must succeed")?;
+            let groups_per_iteration = groups.len();
+            let requirements_per_iteration = groups
+                .iter()
+                .map(|group| group["requirements"].as_array().map_or(0, Vec::len))
+                .sum::<usize>();
+            let start = Instant::now();
+            let mut completed_iterations = 0_u64;
+            for _ in 0..iterations {
+                black_box(case.flatten()?);
+                completed_iterations += 1;
+            }
+            let elapsed_ns = start.elapsed().as_nanos();
+            ensure!(case.report()? == before, "post-clock behavior changed");
+            println!(
+                "{}",
+                json!({"schema": "uv-pr244-api-sample-v1", "fixture_sha256": fixture_sha256, "case": case_id, "clock": clock, "iterations": iterations, "groups_per_iteration": groups_per_iteration, "requirements_per_iteration": requirements_per_iteration, "completed_iterations": completed_iterations, "elapsed_ns": elapsed_ns})
+            );
+        }
+        _ => bail!("expected admit FIXTURE or sample FIXTURE CASE CLOCK ITERATIONS"),
+    }
+    Ok(())
+}
