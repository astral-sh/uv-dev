+// Keep the same allocator used by the production uv binary.
+extern crate uv_performance_memory_allocator;
+
+pub mod shared;
+
+use std::hint::black_box;
+use std::time::Instant;
+
+use anyhow::{Context, Result, bail, ensure};
+use serde_json::json;
+use sha2::{Digest, Sha256};
+
+fn main() -> Result<()> {
+    let arguments = std::env::args().skip(1).collect::<Vec<_>>();
+    let [mode, census_path, rest @ ..] = arguments.as_slice() else {
+        bail!("expected admit CENSUS or sample CENSUS CASE CLOCK ITERATIONS");
+    };
+    let census_bytes = std::fs::read(census_path)?;
+    let census = shared::parse_census(&census_bytes)?;
+    let census_sha256 = Sha256::digest(&census_bytes).iter().map(|byte| format!("{byte:02x}")).collect::<String>();
+    match (mode.as_str(), rest) {
+        ("admit", []) => {
+            println!(
+                "{}",
+                json!({"census_sha256": census_sha256, "payload": shared::admit(&census)?})
+            );
+        }
+        ("sample", [case_id, clock, iterations]) => {
+            ensure!(shared::CLOCKS.contains(&clock.as_str()), "unknown clock");
+            let iterations = iterations
+                .parse::<u64>()
+                .context("invalid iteration count")?;
+            ensure!(
+                (1..=1_048_576).contains(&iterations),
+                "iteration count exceeds fixed cap"
+            );
+            let case = shared::case_for_id(&census, case_id)?;
+            let admission = case.report()?;
+            let expected = admission["decisions"]
+                .as_array()
+                .context("missing decisions")?
+                .iter()
+                .filter(|decision| decision["included"] == true)
+                .count() as u64;
+            let options = (clock == "amortized_lookup").then(|| case.options());
+            let start = Instant::now();
+            let mut included = 0_u64;
+            for _ in 0..iterations {
+                let count = if let Some(options) = &options {
+                    case.lookup(options)
+                } else {
+                    case.construct_and_lookup()
+                };
+                included = included.wrapping_add(black_box(count as u64));
+            }
+            let elapsed_ns = start.elapsed().as_nanos();
+            ensure!(
+                included == expected.wrapping_mul(iterations),
+                "sample result changed"
+            );
+            println!(
+                "{}",
+                json!({"schema": "uv-pr252-api-sample-v1", "census_sha256": census_sha256, "case": case_id, "clock": clock, "iterations": iterations, "queries_per_iteration": case.targets.len(), "included_per_iteration": expected, "included_checksum": included, "elapsed_ns": elapsed_ns})
+            );
+        }
+        _ => bail!("expected admit CENSUS or sample CENSUS CASE CLOCK ITERATIONS"),
+    }
+    Ok(())
+}
