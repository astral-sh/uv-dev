+// Keep the same allocator used by the production uv binary.
+extern crate uv_performance_memory_allocator;
+
+#[path = "../examples/install_options_study/shared.rs"]
+pub mod shared;
+
+use std::hint::black_box;
+use std::path::Path;
+
+use criterion::{BenchmarkId, Criterion, criterion_group, criterion_main, measurement::WallTime};
+
+fn install_package_filters(c: &mut Criterion<WallTime>) {
+    let census_path =
+        std::env::var("UV_PR252_CENSUS").expect("UV_PR252_CENSUS must name the admitted census");
+    let census = shared::read_census(Path::new(&census_path)).expect("admitted census");
+    let mut group = c.benchmark_group("install_package_filters_actual_api");
+    for case in shared::timed_cases(&census).expect("admitted cases") {
+        case.report().expect("complete behavior oracle");
+        let options = case.options();
+        group.bench_function(
+            BenchmarkId::new("construct_and_lookup", &case.id),
+            |benchmark| {
+                benchmark.iter(|| black_box(case.construct_and_lookup()));
+            },
+        );
+        group.bench_function(
+            BenchmarkId::new("amortized_lookup", &case.id),
+            |benchmark| {
+                benchmark.iter(|| black_box(case.lookup(&options)));
+            },
+        );
+    }
+    group.finish();
+}
+
+criterion_group!(install_options, install_package_filters);
+criterion_main!(install_options);
