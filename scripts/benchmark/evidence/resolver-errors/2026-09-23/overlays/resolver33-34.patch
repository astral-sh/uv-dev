diff --git a/crates/uv-resolver/src/error_report_benchmark.rs b/crates/uv-resolver/src/error_report_benchmark.rs
new file mode 100644
--- /dev/null
+++ b/crates/uv-resolver/src/error_report_benchmark.rs
@@ -0,0 +1,368 @@
+//! Source-overlay benchmark for the real no-solution reporting pipeline.
+
+use std::hint::black_box;
+use std::path::PathBuf;
+use std::time::Duration;
+
+use criterion::{BatchSize, Criterion};
+use uv_distribution_types::{
+    ExcludeNewerValue, IncompatibleDist, IncompatibleWheel, RequiresPython,
+};
+use uv_pep508::MarkerEnvironmentBuilder;
+
+use super::*;
+use crate::resolver::UnavailableVersion;
+use crate::{ExcludeNewer, Manifest, VersionsResponse};
+
+const EXCLUDE_CASES: &[(&str, Shape)] = &[
+    ("comb_plain_32", Shape::Comb(32, false)),
+    ("comb_plain_1024", Shape::Comb(1024, false)),
+    ("balanced_plain_1024", Shape::Balanced(1024, false)),
+    ("comb_excluded_256", Shape::Comb(256, true)),
+    ("balanced_excluded_256", Shape::Balanced(256, true)),
+];
+const SHARED_CASES: &[(&str, Shape)] = &[
+    ("comb_plain_32", Shape::Comb(32, false)),
+    ("shared_identified_12", Shape::Shared(12, true)),
+    ("shared_identified_16", Shape::Shared(16, true)),
+    ("shared_unidentified_10", Shape::Shared(10, false)),
+];
+
+#[derive(Clone, Copy)]
+enum Shape {
+    Comb(usize, bool),
+    Balanced(usize, bool),
+    Shared(usize, bool),
+}
+
+struct Fixture {
+    name: &'static str,
+    shape: Shape,
+    tree: StackSafeErrorTree,
+}
+
+fn derived(cause1: Arc<ErrorTree>, cause2: Arc<ErrorTree>, id: usize) -> Arc<ErrorTree> {
+    Arc::new(ErrorTree::Derived(Derived {
+        terms: Map::default(),
+        shared_id: Some(id),
+        cause1,
+        cause2,
+    }))
+}
+
+fn plain_leaf(index: usize) -> Arc<ErrorTree> {
+    Arc::new(ErrorTree::External(External::NotRoot(
+        PubGrubPackage::from(PubGrubPackageInner::Root(None)),
+        Version::new([u64::try_from(index).unwrap() + 1]),
+    )))
+}
+
+fn excluded_leaf(index: usize) -> Arc<ErrorTree> {
+    // The ordinary root cause keeps adjacent exclusions from being collapsed
+    // into one unavailable-version statement before hint generation.
+    derived(
+        plain_leaf(index),
+        Arc::new(ErrorTree::External(External::Custom(
+            PubGrubPackage::base("example".parse().unwrap()),
+            Range::singleton(Version::new([2 * u64::try_from(index).unwrap() + 2])),
+            UnavailableReason::Version(UnavailableVersion::IncompatibleDist(
+                IncompatibleDist::Wheel(IncompatibleWheel::ExcludeNewer(None)),
+            )),
+        ))),
+        index,
+    )
+}
+
+fn ordinary_tree(count: usize, excluded: bool, balanced: bool) -> ErrorTree {
+    assert!(count.is_power_of_two());
+    let leaf = |index| {
+        if excluded {
+            excluded_leaf(index)
+        } else {
+            plain_leaf(index)
+        }
+    };
+    let mut next_id = count;
+    let mut tree = if balanced {
+        let mut level: Vec<_> = (0..count).map(leaf).collect();
+        while level.len() > 1 {
+            level = level
+                .chunks_exact(2)
+                .map(|pair| {
+                    let node = derived(pair[0].clone(), pair[1].clone(), next_id);
+                    next_id += 1;
+                    node
+                })
+                .collect();
+        }
+        level.pop().unwrap()
+    } else {
+        let mut tree = leaf(0);
+        for index in 1..count {
+            tree = derived(tree, leaf(index), next_id);
+            next_id += 1;
+        }
+        tree
+    };
+    if excluded {
+        tree = derived(
+            tree,
+            Arc::new(ErrorTree::External(External::NoVersions(
+                PubGrubPackage::base("example".parse().unwrap()),
+                Range::singleton(Version::new([1_u64])),
+            ))),
+            next_id,
+        );
+    }
+    Arc::unwrap_or_clone(tree)
+}
+
+fn shared_tree(depth: usize, identified: bool) -> ErrorTree {
+    // This is the shared-diamond construction used by the error-tree tests.
+    // The dependency leaf also reaches the requested-range hint collector.
+    let mut tree = Arc::new(ErrorTree::External(External::FromDependencyOf(
+        PubGrubPackage::base("parent".parse().unwrap()),
+        Range::singleton(Version::new([1_u64])),
+        PubGrubPackage::base("dependency".parse().unwrap()),
+        Range::singleton(Version::new([2_u64])),
+    )));
+    for id in 0..depth {
+        tree = Arc::new(ErrorTree::Derived(Derived {
+            terms: Map::default(),
+            shared_id: identified.then_some(id),
+            cause1: tree.clone(),
+            cause2: tree,
+        }));
+    }
+    Arc::unwrap_or_clone(tree)
+}
+
+fn marker_environment() -> MarkerEnvironment {
+    MarkerEnvironment::try_from(MarkerEnvironmentBuilder {
+        implementation_name: "cpython",
+        implementation_version: "3.12.0",
+        os_name: "posix",
+        platform_machine: "x86_64",
+        platform_python_implementation: "CPython",
+        platform_release: "",
+        platform_system: "Linux",
+        platform_version: "",
+        python_full_version: "3.12.0",
+        python_version: "3.12",
+        sys_platform: "linux",
+    })
+    .expect("valid fixed marker environment")
+}
+
+impl Fixture {
+    fn new(name: &'static str, shape: Shape) -> Self {
+        let tree = match shape {
+            Shape::Comb(count, excluded) => ordinary_tree(count, excluded, false),
+            Shape::Balanced(count, excluded) => ordinary_tree(count, excluded, true),
+            Shape::Shared(depth, identified) => shared_tree(depth, identified),
+        };
+        Self {
+            name,
+            shape,
+            tree: StackSafeErrorTree::new(tree),
+        }
+    }
+
+    fn error(&self) -> NoSolutionError {
+        let current_environment = marker_environment();
+        let python_requirement = PythonRequirement::from_marker_environment(
+            &current_environment,
+            RequiresPython::greater_than_equal_version(&Version::new([3_u64, 12])),
+        );
+        let env = ResolverEnvironment::universal(vec![]);
+        let mut options = Options::default();
+        let mut available_versions = FxHashMap::default();
+        let index = InMemoryIndex::default();
+        if let Shape::Comb(count, true) | Shape::Balanced(count, true) = self.shape {
+            let name: PackageName = "example".parse().unwrap();
+            available_versions.insert(
+                name.clone(),
+                std::iter::once(Version::new([1_u64]))
+                    .chain(
+                        (0..count)
+                            .map(|index| Version::new([2 * u64::try_from(index).unwrap() + 2])),
+                    )
+                    .collect(),
+            );
+            index
+                .implicit()
+                .done(name, Arc::new(VersionsResponse::Found(vec![])));
+            options.exclude_newer = ExcludeNewer::global(ExcludeNewerValue::absolute(
+                "2022-01-01T00:00:00Z".parse().unwrap(),
+            ));
+        }
+        let selector = CandidateSelector::for_resolution(&options, &Manifest::simple(vec![]), &env);
+        NoSolutionError::new(
+            (*self.tree).clone(),
+            index,
+            FxHashMap::default(),
+            available_versions,
+            FxHashMap::default(),
+            selector,
+            python_requirement,
+            IndexLocations::default(),
+            IndexCapabilities::default(),
+            FxHashMap::default(),
+            FxHashMap::default(),
+            ForkUrls::default(),
+            ForkIndexes::default(),
+            env,
+            current_environment,
+            None,
+            BTreeSet::default(),
+            options,
+        )
+    }
+
+    fn input_shape(&self) -> serde_json::Value {
+        let mut seen = FxHashSet::default();
+        let mut pending = vec![&*self.tree];
+        let mut external = 0;
+        let mut derived = 0;
+        let mut repeated_edges = 0;
+        while let Some(tree) = pending.pop() {
+            if !seen.insert(std::ptr::from_ref(tree)) {
+                repeated_edges += 1;
+                continue;
+            }
+            match tree {
+                ErrorTree::External(_) => external += 1,
+                ErrorTree::Derived(node) => {
+                    derived += 1;
+                    pending.push(&node.cause1);
+                    pending.push(&node.cause2);
+                }
+            }
+        }
+        serde_json::json!({
+            "unique_nodes": seen.len(), "external_nodes": external,
+            "derived_nodes": derived, "repeated_edges": repeated_edges,
+        })
+    }
+
+    fn inspect(&self) -> serde_json::Value {
+        let expected_shape = match self.shape {
+            Shape::Comb(count, false) | Shape::Balanced(count, false) => {
+                (2 * count - 1, count, count - 1, 0)
+            }
+            Shape::Comb(count, true) | Shape::Balanced(count, true) => {
+                (4 * count + 1, 2 * count + 1, 2 * count, 0)
+            }
+            Shape::Shared(depth, _) => (depth + 1, 1, depth, depth),
+        };
+        let input = self.input_shape();
+        assert_eq!(
+            input,
+            serde_json::json!({
+                "unique_nodes": expected_shape.0, "external_nodes": expected_shape.1,
+                "derived_nodes": expected_shape.2, "repeated_edges": expected_shape.3,
+            })
+        );
+        let error = self.error();
+        assert!(error.cached.get().is_none());
+        // Display calls report() -> cached() -> compute_report_and_hints().
+        // A fresh cache makes this a real execution of every reduction, the
+        // derivation reporter, and generate_hints, not a cached-string lookup.
+        let report = error.to_string();
+        assert!(error.cached.get().is_some());
+        assert!(!report.is_empty());
+        let hints: Vec<_> = error
+            .pubgrub_hints()
+            .iter()
+            .map(ToString::to_string)
+            .collect();
+        assert_eq!(error.to_string(), report);
+        let excluded = matches!(self.shape, Shape::Comb(_, true) | Shape::Balanced(_, true));
+        assert_eq!(hints.len(), usize::from(excluded));
+        if excluded {
+            assert!(matches!(
+                error.pubgrub_hints().get_index(0),
+                Some(PubGrubHint::ExcludeNewer { .. })
+            ));
+        }
+        serde_json::json!({
+            "case": self.name, "input": input,
+            "entrypoint": "NoSolutionError::fmt", "fresh_cache": true,
+            "cache_populated": true, "report": report, "hints": hints,
+        })
+    }
+}
+
+fn completed_report(error: NoSolutionError) {
+    let report = black_box(error.to_string());
+    let hints = black_box(
+        error
+            .pubgrub_hints()
+            .iter()
+            .map(ToString::to_string)
+            .collect::<Vec<_>>(),
+    );
+    black_box((&report, &hints));
+    // The complete operation includes the formatted outputs and error owner
+    // being dropped. Fixture construction is outside the measurement.
+    drop(hints);
+    drop(report);
+    drop(error);
+}
+
+#[test]
+#[ignore = "requires an explicit source-bound benchmark mode"]
+#[expect(clippy::print_stdout)]
+fn no_solution_error_benchmark() {
+    let suite = std::env::var("UV_NO_SOLUTION_BENCH_SUITE").expect("explicit benchmark suite");
+    let cases = match suite.as_str() {
+        "exclude_newer" => EXCLUDE_CASES,
+        "shared_derivation" => SHARED_CASES,
+        _ => panic!("unknown benchmark suite"),
+    };
+    let fixtures: Vec<_> = cases
+        .iter()
+        .map(|(name, shape)| Fixture::new(name, *shape))
+        .collect();
+    match std::env::var("UV_NO_SOLUTION_BENCH_MODE").as_deref() {
+        Ok("inspect") => {
+            let records: Vec<_> = fixtures.iter().map(Fixture::inspect).collect();
+            println!(
+                "UV_NO_SOLUTION_BENCH_RECORD={}",
+                serde_json::json!({
+                    "schema": "uv-future.no-solution-report-specimen.v1",
+                    "suite": suite, "records": records,
+                })
+            );
+        }
+        Ok("measure") => {
+            let output = PathBuf::from(std::env::var_os("UV_NO_SOLUTION_BENCH_OUTPUT").unwrap());
+            assert!(output.is_absolute());
+            assert!(
+                matches!(std::fs::symlink_metadata(&output), Err(error)
+                if error.kind() == std::io::ErrorKind::NotFound),
+                "Criterion output must be fresh"
+            );
+            let mut criterion = Criterion::default()
+                .sample_size(20)
+                .warm_up_time(Duration::from_secs(1))
+                .measurement_time(Duration::from_secs(3))
+                .nresamples(20_000)
+                .confidence_level(0.95)
+                .without_plots()
+                .with_output_color(false)
+                .output_directory(&output);
+            for fixture in &fixtures {
+                criterion.bench_function(fixture.name, |bench| {
+                    bench.iter_batched(
+                        || fixture.error(),
+                        completed_report,
+                        BatchSize::PerIteration,
+                    );
+                });
+            }
+            criterion.final_summary();
+        }
+        _ => panic!("explicit inspect or measure mode required"),
+    }
+}
