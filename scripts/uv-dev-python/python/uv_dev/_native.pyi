from collections.abc import Sequence
from typing import Self

def python_download_keys(metadata: str) -> dict[str, str]:
    """Convert catalog entries to installation keys, rejecting invalid platform, variant, and version fields."""

def normalize_package_name(value: str) -> str: ...

class Version:
    def __new__(cls, value: str) -> Self: ...
    def __hash__(self) -> int: ...
    def __eq__(self, other: object, /) -> bool: ...
    def __lt__(self, other: Version, /) -> bool: ...
    def __le__(self, other: Version, /) -> bool: ...
    def __gt__(self, other: Version, /) -> bool: ...
    def __ge__(self, other: Version, /) -> bool: ...
    @property
    def release(self) -> tuple[int, ...]: ...
    @property
    def is_prerelease(self) -> bool: ...

class VersionSpecifiers:
    def __new__(cls, value: str) -> Self: ...
    def __contains__(self, version: Version) -> bool:
        """Apply uv's comparisons without resolver prerelease selection policy."""

class Requirement:
    def __new__(cls, value: str) -> Self: ...
    @property
    def name(self) -> str: ...
    @property
    def extras(self) -> tuple[str, ...]: ...
    @property
    def specifiers(self) -> VersionSpecifiers | None: ...
    @property
    def url(self) -> str | None: ...
    @property
    def marker(self) -> str | None: ...
    def evaluate(
        self, environment: dict[str, str], *, extras: Sequence[str] = ()
    ) -> bool: ...

class Marker:
    def __new__(cls, value: str) -> Self: ...
    def __eq__(self, other: object, /) -> bool: ...
    def __hash__(self) -> int: ...
    @property
    def normalized(self) -> str | None:
        """The simplified expression, or `None` when it simplifies to true."""
    @property
    def is_true(self) -> bool: ...
    @property
    def is_false(self) -> bool: ...
    def evaluate(
        self, environment: dict[str, str], *, extras: Sequence[str] = ()
    ) -> bool:
        """Evaluate a complete PEP 508 environment without host defaults."""
